# credentials - never commit
.env
.env.*
!.env.example

# The deny-list the leak checks read. It names the things the published corpus must not name,
# so committing it would publish exactly what it exists to withhold. See the file's header.
.leaklist

# scratch dir for the Jev benchmark's `ai` SDK, recreated on demand
.bench/
node_modules/

# this repo is deployed as static files; nothing here is built
.vercel/
.wrangler/

# source material, not part of the site. data/cv.json is what ships.
# the .txt files are extracts made from these by hand.
*.pdf
*.txt
!README.md
# llms.txt is caught by the *.txt rule above and must ship anyway - it is the
# page an LLM reads. Narrower than !*.txt, so the CV extracts stay ignored.
!llms.txt
